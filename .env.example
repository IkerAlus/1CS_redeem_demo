# Copy to .env and fill in. `.env` is git-ignored. Never commit real values.

# ── Facilitator (gateway stand-in only) ─────────────────────────────────────
# Coinbase Developer Platform *Secret* API key: portal.cdp.coinbase.com → API keys → Secret.
# Needed for verify/settle on mainnet; the gateway will not boot without it.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ── 1Click Swap API (redeem module) ─────────────────────────────────────────
# Optional partner JWT from partners.near-intents.org. Without it every quote carries a 0.2 % fee.
ONE_CLICK_JWT=
# Optional referral tag sent on every quote (attribution / fee share).
ONE_CLICK_REFERRAL=1cs-redeem-demo

# ── Wallets ─────────────────────────────────────────────────────────────────
# Buyer: fresh EOA. Fund with ~3 USDC on each of Base, Polygon, Arbitrum. No gas needed (the facilitator pays).
BUYER_PRIVATE_KEY=0x
# Merchant: fresh EOA. Receives the x402 payments and signs the redeem transfers.
# Needs a few cents of native gas on each network (ETH on Base and Arbitrum, POL on Polygon). No USDC.
MERCHANT_PRIVATE_KEY=0x
MERCHANT_WALLET=0x

# ── Gateway stand-in ────────────────────────────────────────────────────────
GATEWAY_PORT=4021
PRICE_USD=0.05                # per /article payment; raise to 0.25 for the Tron run (1.00 USDT minimum)
NETWORKS=eip155:8453,eip155:137,eip155:42161
BALANCES_FILE=./balances.json

# ── Redeem module ───────────────────────────────────────────────────────────
MODULE_PORT=4022
REDEEM_WINDOW_MIN=30          # 1CS request deadline (refund cutoff). Set to 1 only for the late-send demo run.
POLL_MS=5000
LEDGER_FILE=./ledger.json

# ── Public RPCs (merchant CLI only, for the redeem transfer). Defaults shown; override if rate-limited.
RPC_BASE=https://mainnet.base.org
RPC_POLYGON=https://polygon-rpc.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
