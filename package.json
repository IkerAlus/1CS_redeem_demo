    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coinbase/x402": "2.1.0",
    "@defuse-protocol/one-click-sdk-typescript": "0.1.25",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/express": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/paywall": "2.25.0",
    "express": "5.2.1",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
