{
  "name": "1cs-redeem-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Redeem-to-any-chain payout demo for x402 payment gateways, settled through NEAR Intents 1Click Swap",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gateway": "tsx src/gateway.ts",
